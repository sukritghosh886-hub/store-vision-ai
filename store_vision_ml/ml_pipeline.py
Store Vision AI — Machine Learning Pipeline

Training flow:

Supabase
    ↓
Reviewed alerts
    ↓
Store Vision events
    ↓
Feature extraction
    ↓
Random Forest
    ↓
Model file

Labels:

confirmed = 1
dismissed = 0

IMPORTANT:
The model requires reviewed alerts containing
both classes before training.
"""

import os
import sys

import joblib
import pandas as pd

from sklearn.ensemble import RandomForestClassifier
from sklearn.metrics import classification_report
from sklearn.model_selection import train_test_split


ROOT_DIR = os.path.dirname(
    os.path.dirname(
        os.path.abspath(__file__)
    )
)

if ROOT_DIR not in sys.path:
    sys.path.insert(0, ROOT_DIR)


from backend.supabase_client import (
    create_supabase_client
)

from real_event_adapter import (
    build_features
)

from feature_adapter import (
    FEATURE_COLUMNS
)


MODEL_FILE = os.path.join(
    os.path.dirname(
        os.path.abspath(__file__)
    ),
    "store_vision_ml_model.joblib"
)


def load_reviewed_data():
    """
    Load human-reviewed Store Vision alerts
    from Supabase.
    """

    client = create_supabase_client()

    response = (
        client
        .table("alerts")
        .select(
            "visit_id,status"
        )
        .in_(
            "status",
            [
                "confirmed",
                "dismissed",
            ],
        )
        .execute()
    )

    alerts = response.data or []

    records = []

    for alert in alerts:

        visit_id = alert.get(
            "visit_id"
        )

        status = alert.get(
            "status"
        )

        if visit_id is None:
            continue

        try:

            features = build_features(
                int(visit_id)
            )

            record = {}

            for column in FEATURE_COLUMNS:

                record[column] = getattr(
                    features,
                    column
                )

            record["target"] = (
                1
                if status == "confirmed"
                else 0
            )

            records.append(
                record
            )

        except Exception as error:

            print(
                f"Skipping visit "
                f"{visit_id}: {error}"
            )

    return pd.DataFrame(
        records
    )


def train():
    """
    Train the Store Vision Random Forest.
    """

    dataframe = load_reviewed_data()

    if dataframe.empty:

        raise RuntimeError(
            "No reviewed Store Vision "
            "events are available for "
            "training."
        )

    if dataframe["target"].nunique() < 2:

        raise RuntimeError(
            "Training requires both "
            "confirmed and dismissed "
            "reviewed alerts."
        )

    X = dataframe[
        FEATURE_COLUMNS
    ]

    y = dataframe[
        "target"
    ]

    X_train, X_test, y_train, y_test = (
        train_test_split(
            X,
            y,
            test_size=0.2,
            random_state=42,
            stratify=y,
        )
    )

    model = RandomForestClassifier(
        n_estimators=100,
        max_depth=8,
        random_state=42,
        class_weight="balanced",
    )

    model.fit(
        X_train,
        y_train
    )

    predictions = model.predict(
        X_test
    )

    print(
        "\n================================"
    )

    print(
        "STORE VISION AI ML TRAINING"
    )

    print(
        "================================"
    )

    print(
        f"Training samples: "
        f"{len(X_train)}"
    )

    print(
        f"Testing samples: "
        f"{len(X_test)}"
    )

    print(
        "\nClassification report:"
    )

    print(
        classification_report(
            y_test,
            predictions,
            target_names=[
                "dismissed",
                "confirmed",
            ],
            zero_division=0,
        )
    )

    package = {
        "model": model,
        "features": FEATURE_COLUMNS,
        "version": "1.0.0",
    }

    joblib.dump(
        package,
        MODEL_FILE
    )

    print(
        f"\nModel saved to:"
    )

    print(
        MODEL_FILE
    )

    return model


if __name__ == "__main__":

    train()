"""
Store Vision AI — ML Pipeline

High-level utilities for:

1. synthetic dataset generation
2. model training
3. runtime prediction

IMPORTANT:
Synthetic training is for prototype development.
Reviewed application outcomes should be used
for future real-world model development.
"""

from pathlib import Path

from .generate_dataset import (
    generate_dataset,
)

from .predict import (
    predict_risk,
)

from .train_model import (
    train_model,
)


BASE_DIR = Path(__file__).resolve().parent


def prepare_synthetic_model():
    """
    Generate synthetic training data and train
    the prototype Random Forest model.
    """

    generate_dataset()

    train_model()

    return {
        "status": "success",
        "training_data": "synthetic",
        "model_file": str(
            BASE_DIR
            / "store_vision_ml_model.joblib"
        ),
    }


def predict_visit(features):
    """
    Run the runtime predictor on a feature object.
    """

    return predict_risk(
        features
    )


if __name__ == "__main__":

    result = prepare_synthetic_model()

    print(
        result
    )